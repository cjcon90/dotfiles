#!/bin/sh

STATUS=$(protonvpn-cli status 2>/dev/null | grep -i "status" | awk '{print $2}')

if [ "$STATUS" = "Connected" ]; then
    SERVER=$(protonvpn-cli status 2>/dev/null | grep -i "server" | awk '{print $2}')
    notify-send "VPN Status" "Connected to $SERVER"
else
    notify-send "VPN Status" "Not currently connected"
fi

exit 0
