{
  "position": "bottom",
  "height": 38,
  "modules-left": [
    "sway/workspaces",
    "custom/media"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "idle_inhibitor",
    "custom/brightness",
    "pulseaudio",
    "temperature",
    "network",
    "custom/vpn",
    "battery",
    "bluetooth"
  ],
  "margin-top": 0,
  "margin-left": 15,
  "margin-right": 15,
  "margin-bottom": 10,
  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "format": "{icon}",
    "format-icons": {
      "1": "I",
      "2": "II",
      "3": "III",
      "4": "IV",
      "5": "V",
      "6": "VI",
      "7": "VII",
      "8": "VIII",
      "9": "IX",
      "10": "X"
    }
  },
  "clock": {
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "format": "{:%H:%M}  ",
    "format-alt": "{:%H:%M %a %d/%m/%y} 󰃰 ",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "left",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#f8f8f2'><b>{}</b></span>",
        "today": "<span color='#ff79c6'><b><u>{}</u></b></span>",
        "weekdays": "<span color='#bd93f9'><b>{}</b></span>",
        "weeks": "<span color='#6272a4'>W{}</span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
      "on-click-middle": "shift_reset"
    }
  },
  "idle_inhibitor": {
    "format": "{icon} ",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    },
    "tooltip-format-activated": "Idle inhibitor: on",
    "tooltip-format-deactivated": "Idle inhibitor: off"
  },
  "custom/brightness": {
    "exec": "~/.config/waybar/scripts/brightness.sh get",
    "return-type": "json",
    "interval": 60,
    "signal": 8,
    "format": " {icon} {percentage}% ",
    "format-icons": [
      "", 
      "", 
      "", 
      "", 
      "", 
      "", 
      "", 
      "", 
      ""
    ],
    "on-scroll-up": "~/.config/waybar/scripts/brightness.sh up",
    "on-scroll-down": "~/.config/waybar/scripts/brightness.sh down"
  },
  "battery": {
    "bat": "BAT0",
    "states": {
      "warning": 25,
      "critical": 5
    },
    "format": " {icon}  {capacity}% ",
    "tooltip-format": " {timeTo}, {capacity}% ",
    "format-plugged": " 󰂄 {capacity}% ",
    "format-charging": " 󰢜 {capacity}% ",
    "format-icons": [
      "󰂎",
      "󰁻",
      "󰁾",
      "󰂀",
      "󰁹"
    ],
    "interval": 5
  },
  "pulseaudio": {
    "format": " {icon} {volume}% ",
    "format-muted": "󰖁",
    "format-icons": [
      "󰕿",
      "󰖀",
      "󰕾"
    ],
    "scroll-step": 1
  },
  "custom/vpn": {
    "exec": "nmcli con show --active 2>/dev/null | grep -oP 'proton[^ ]*' | head -1 | xargs -I{} echo ' {} ' || echo ''",
    "interval": 5
  },
  "network": {
    "format-wifi": " 󰖩 {essid} ({signalStrength}%) ",
    "max-length": 20,
    "format-ethernet": " 󰈀 {ifname} ",
    "format-disconnected": " 󰖪 ",
    "tooltip-format": "{essid} {signalStrength}%",
    "on-click": "~/.config/sway/wifi-menu.sh",
    "on-click-right": "/usr/bin/nm-connection-editor"
  },
  "custom/media": {
    "exec": "python $HOME/.config/waybar/scripts/mediaplayer.py",
    "format": "󰝚 {}",
    "escape": true,
    "max-length": 45,
    "return-type": "json",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  "temperature": {
    "thermal-zone": 1,
    "critical-threshold": 80,
    "format": " 󰔏 {temperatureC}°C ",
    "format-critical": " 󰔏 {temperatureC}°C ",
    "interval": 5,
    "on-click": "alacritty -e btop"
  },
  "bluetooth": {
    "format-off": " 󰂲 off ",
    "format-on": " 󰂯 disconnected ",
    "format-connected": " 󰂱 {device_alias} ",
    "format-connected-battery": " 󰂱 {device_alias}({device_battery_percentage}%) ",
    "interval": 5,
    "tooltip-format": "{status}",
    "on-click": "/usr/bin/blueman-manager"
  }
}
