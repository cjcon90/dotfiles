{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "color": { "1": "38;2;189;147;249", "2": "38;2;255;121;198" },
    "padding": { "top": 1, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;189;147;249", "title": "38;2;255;121;198" }
  },
  "modules": [
    "title",
    { "type": "separator", "string": "─" },
    { "type": "os", "key": "" },
    { "type": "kernel", "key": "" },
    { "type": "uptime", "key": "󰅐" },
    { "type": "packages", "key": "󰏖" },
    { "type": "wm", "key": "" },
    { "type": "terminal", "key": "" },
    { "type": "shell", "key": "" },
    { "type": "cpu", "key": "" },
    { "type": "gpu", "key": "󰢮" },
    { "type": "memory", "key": "󰍛" },
    { "type": "disk", "key": "󰋊", "folders": "/" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
