* {
	bg: #282a36;
	dark: #21222c;
	white: #f8f8f2;
	comment: #6272a4;
	cyan: #8be9fd;
	green: #50fa7b;
	orange: #ffb86c;
	pink: #ff79c6;
	purple: #bd93f9;
	red: #ff5555;
	yellow: #f1fa8c;
	highlight-pink: bold #ff79c6;
	
	background-color: transparent;
	text-color: @white;

	margin: 0;
	padding: 0;
	font: "Blex Mono Nerd Font SemiBold 11";
}

run {
  display-name: ">_";
}

window {
	fullscreen: false;
	children: [inputbar, listview];
  height: 60%;
  width: 40%;
  border: 2px;
  border-color: rgba(189, 147, 249, 0.7);
  border-radius: 12px;
  padding: 10px;
  background-color: rgba(40, 42, 54, 0.85);
}

inputbar {
  children: [textbox-search, entry];
  margin: 10px;
  padding: 10px 12px;
  spacing: 10px;
  background-color: @dark;
  border-radius: 8px;
}

textbox-search {
  expand: false;
  str: "󰍉";
  text-color: @purple;
	font: "Blex Mono Nerd Font SemiBold 12";
}

entry {
	text-color: @pink;
	font: "Blex Mono Nerd Font SemiBold 12";
  placeholder: "Search";
  placeholder-color: @comment;
}

button {
  padding: 0 8px;
  text-color: @comment;
}

button selected {
  text-color: @purple;
}

listview {
  padding: 0 10px 10px;
  spacing: 4px;
}

element {
	padding: 10px 12px;
	spacing: 10px;
	border-radius: 5px;
	children: [element-icon, element-text];
}

element selected {
	background-color: #44475a;
	text-color: @purple;
	border: 2px;
	border-color: @purple;
	border-radius: 8px;
}

element-text {
	background-color: inherit;
	text-color: inherit;
	highlight: @highlight-pink;
	vertical-align: 0.50;
}

element-icon {
	size: 1.3em;
	background-color: inherit;
	margin: 0;
	padding: 0;
}
