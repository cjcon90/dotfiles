@import "dracula.rasi"

window {
  children: [message, listview];
  width: 620px;
  height: 190px;
}

message {
  margin: 4px 10px 0;
  padding: 0;
}

textbox {
  padding: 10px 0 0;
  horizontal-align: 0.5;
  text-color: @comment;
}

listview {
  columns: 5;
  lines: 1;
  spacing: 10px;
  fixed-columns: true;
}

element {
  orientation: vertical;
  children: [element-text];
  padding: 18px 0;
}

element-text {
  padding: 10px 10px 18px;
  horizontal-align: 0.5;
}
