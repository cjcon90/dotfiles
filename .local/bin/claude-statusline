#!/bin/bash
# Claude Code status line: Dracula pills to match lualine and tmux.
IFS=$'\t' read -r model dir pct < <(jq -r '[.model.display_name, .workspace.current_dir, (.context_window.used_percentage // 0 | floor)] | @tsv')
branch=$(git -C "$dir" branch --show-current 2>/dev/null)

fg() { printf '\e[38;2;%sm' "$1"; }
bg() { printf '\e[48;2;%sm' "$1"; }
purple='189;147;249' slate='95;106;142' line='68;71;90' ink='40;42;54' text='248;248;242'
ctx=$purple
((pct >= 50)) && ctx='241;250;140'
((pct >= 80)) && ctx='255;121;198'

out="$(fg $purple)$(bg $purple)$(fg $ink)\e[1m $model \e[22m"
out+="$(fg $purple)$(bg $slate)$(fg $text) ${dir/#$HOME/\~} "
out+="$(fg $slate)$(bg $line)"
[ -n "$branch" ] && out+="$(fg '191;191;191')  $branch "
out+="$(fg $ctx) ctx $pct% \e[0m$(fg $line)\e[0m"
printf '%b' "$out"
